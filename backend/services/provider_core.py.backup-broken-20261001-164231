def provider_status():
    c = db()

    try:
        rows = c.execute(
            """
            SELECT
                id,
                name,
                provider_type,
                active,
                created_at
            FROM providers
            ORDER BY id
            """
        ).fetchall()

        return [dict(r) for r in rows]

    finally:
        c.close()
